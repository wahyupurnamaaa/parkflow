# Docker Compose environment. Generate a unique key: php -r 'echo "base64:".base64_encode(random_bytes(32)).PHP_EOL;'
APP_KEY=
APP_ENV=production
APP_URL=http://localhost:8080
DB_PASSWORD=replace-with-a-long-random-password
PORT=8080
# Enables demo accounts and 80 slots. Turn off for a real deployment.
DEMO_SEED=true
# Set true only behind HTTPS.
SESSION_SECURE_COOKIE=false
