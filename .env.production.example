# ===========================================
# PARKFLOW PRODUCTION ENVIRONMENT
# Copy this to .env for AWS deployment
# ===========================================

APP_NAME=ParkFlow
APP_ENV=production
APP_DEBUG=false
APP_KEY=

# IMPORTANT: Change APP_URL to your domain
APP_URL=https://parkflow.wahyupurnamaa.com

# ===========================================
# AWS RDS PostgreSQL Configuration
# ===========================================
DB_CONNECTION=pgsql
DB_HOST=YOUR_AWS_RDS_ENDPOINT
DB_PORT=5432
DB_DATABASE=parkflow
DB_USERNAME=parkflow
DB_PASSWORD=YOUR_SECURE_PASSWORD

# ===========================================
# AWS ElastiCache Redis Configuration
# ===========================================
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis

REDIS_HOST=YOUR_AWS_ELASTICACHE_ENDPOINT
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CLIENT=phpredis

# ===========================================
# Logging & Monitoring
# ===========================================
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ===========================================
# Demo Mode (DISABLE IN PRODUCTION!)
# ===========================================
DEMO_SEED=false

# ===========================================
# Security
# ===========================================
APP_TRUST_PROXIES=*

# ===========================================
# AWS Specific (for S3, SES, etc)
# ===========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# ===========================================
# SSL/HTTPS Settings
# ===========================================
FORCE_HTTPS=true
